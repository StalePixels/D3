# .INI reads a key, sets a new key, reads the new key back, and the file holds both.
no-network
mame -nothrottle
put @DOTS@/INI.DOT /dot/INI
put @DATA@/ini/lines.ini /TEST.INI
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart POKE 23692,7
autostart .INI /TEST.INI alpha
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR1 ";s
autostart POKE 23692,7
autostart .INI /TEST.INI gamma third
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR2 ";s
autostart POKE 23692,7
autostart .INI /TEST.INI gamma
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR3 ";s
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 16
screen 15 AFTER
screen 15 first
screen 15 third
screen 15 SCR1 7
screen 15 SCR2 7
screen 15 SCR3 7
check /TEST.INI @DATA@/ini/lines-set.ini
