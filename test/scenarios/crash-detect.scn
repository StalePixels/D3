# RANDOMIZE USR 0 resets the machine, so the line after it never runs. The run
# must fail: this proves that a crash fails a scenario. run.sh expects the failure.
# expect-fail
no-network
mame -nothrottle
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart RANDOMIZE USR 0
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 16
screen 15 AFTER
