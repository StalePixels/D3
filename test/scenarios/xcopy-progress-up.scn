# .XCOPY copies one file of 70001 bytes from the second SD card (D:) to a
# PersonalServer folder. The count after its name ends as "68K/68K".
# It runs at real speed, as all Next network software must.
put @DOTS@/XCOPY.DOT /dot/XCOPY
mame -hard2 @CARD@
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart POKE 23692,7
autostart .XCOPY -z "D:/OVER-64K.BIN" "nbn://127.0.0.1:@PORT@/one"
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR ";s
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 40
screen 38 AFTER
screen 38 SCR 7
screen 38 68K/68K
