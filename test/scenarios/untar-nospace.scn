# .UNTAR d3.tar onto a second SD card (D:) with 512 KiB free. The card fills
# during EVERY.map and the write fails. UNTAR stops, returns an error, and the
# line after it does not run. The error trap reads back the screen row above
# the print position: "Failed write" is the last line UNTAR prints.
no-network
mame -nothrottle -hard2 @CARD@
put @DOTS@/UNTAR.DOT /dot/UNTAR
put @DATA@/d3.tar /D3.TAR
autostart ON ERROR ERROR TO e,l:LET s=PEEK 23692:LET r=24-PEEK 23689:LET a$="":FOR c=0 TO 11:LET a$=a$+SCREEN$ (r-1,c):NEXT c:POKE 23692,255:PRINT "ERR ";e;" ";l:PRINT "SCR ";s:PRINT "LAST ";a$:FOR i=0 TO 1 STEP 0:NEXT i
autostart CD "D:/"
autostart POKE 23692,7
autostart .UNTAR "C:/D3.TAR"
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 90
screen 89 Failed write
screen 89 ERR 255 50
screen 89 SCR 7
screen 89 LAST Failed write
