# .UNTAR extracts a tar file that lists a file before its folders: it makes
# the folders for the file, and returns no error.
no-network
mame -nothrottle
put @DOTS@/UNTAR.DOT /dot/UNTAR
put @DATA@/filefirst.tar /FILEFIRST.TAR
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart POKE 23692,7
autostart .UNTAR /FILEFIRST.TAR
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR ";s
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 16
screen 15 AFTER
screen 15 SCR 7
check /filefirst/DIR/TEST.TXT @DATA@/filefirst/DIR/TEST.TXT
