# .LESS opens a text file, and BREAK returns to BASIC. LESS waits for BREAK to
# go up first, so the line after it runs: MMU6 and MMU7 (NextRegs 0x56, 0x57)
# are as they were before .LESS.
no-network
mame -nothrottle
put @DOTS@/LESS.DOT /dot/LESS
put @DATA@/logo.txt /LOGO.TXT
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart LET m=REG 86:LET n=REG 87
autostart POKE 23692,7
autostart .LESS /LOGO.TXT
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR ";s:PRINT "MMU ";(REG 86=m AND REG 87=n)
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 20
key 12 {BREAK}
screen 19 AFTER
screen 19 SCR 7
screen 19 MMU 1
