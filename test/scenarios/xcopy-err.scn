# .XCOPY with an option it does not have returns an error, and the line after it does not run.
no-network
mame -nothrottle -hard2 @CARD@
put @DOTS@/XCOPY.DOT /dot/XCOPY
autostart ON ERROR ERROR TO e,l:LET s=PEEK 23692:POKE 23692,255:PRINT "ERR ";e;" ";l:PRINT "SCR ";s:FOR i=0 TO 1 STEP 0:NEXT i
autostart POKE 23692,7
autostart .XCOPY -q "D:/" "C:/x"
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 20
screen 19 ERR 255
screen 19 SCR 7
