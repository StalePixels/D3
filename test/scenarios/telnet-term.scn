# The .TELNET terminal: ANSI streams go into the receive ring, and the
# tilemap and the terminal's state must match. tools/telnet-term-probe.lua
# feeds the streams, does the checks and presses EDIT, then Q (see test/README.md).
no-network
mame -nothrottle
put @DOTS@/TELNET.DOT /dot/TELNET
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart .TELNET -pi
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 60
noreset 7.5
screen 59 AFTER
