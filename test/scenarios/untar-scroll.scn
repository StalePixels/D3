# .UNTAR on a tar file of many entries, with the screen full and the ROM's
# scroll count (SCR_CT) at 1, as after a typed command. It never stops at
# "scroll?", and returns to BASIC.
no-network
mame -nothrottle
put @DOTS@/UNTAR.DOT /dot/UNTAR
put @DATA@/d3.tar /D3.TAR
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart FOR i=1 TO 22:PRINT i:NEXT i:POKE 23692,1
autostart .UNTAR /D3.TAR
autostart LET s=PEEK 23692:POKE 23692,255:PRINT "SCR ";s
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 50
screen 49 AFTER
screen 49 SCR 1
