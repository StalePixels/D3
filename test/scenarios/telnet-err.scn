# .TELNET with a port number that is out of range shows its help and
# returns an error, and the line after it does not run.
no-network
mame -nothrottle
put @DOTS@/TELNET.DOT /dot/TELNET
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart .TELNET host 65536
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 20
screen 19 ERR 255
screen 19 Usage
