# .UNTAR extracts a tar file that holds a folder, a file with data, an empty file and a symlink.
no-network
mame -nothrottle
put @DOTS@/UNTAR.DOT /dot/UNTAR
put @DATA@/arkward.tar /ARKWARD.TAR
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart .UNTAR /ARKWARD.TAR
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 16
screen 15 AFTER
check /arkward/DIR/TEST @DATA@/arkward/DIR/TEST
check /arkward/EMPTY_FILE @DATA@/arkward/EMPTY_FILE
