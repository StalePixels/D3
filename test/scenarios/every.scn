# .EVERY 3 is due on every third run. REG 127 is NextReg 0x7F: 0 on the first
# two runs, 1 on the third. The count in /SYS/EVERY.CFG starts again after it.
no-network
mame -nothrottle
put @DOTS@/EVERY.DOT /dot/EVERY
autostart ON ERROR ERROR TO e,l:POKE 23692,255:PRINT "ERR ";e;" ";l:FOR i=0 TO 1 STEP 0:NEXT i
autostart .EVERY 3 job
autostart POKE 23692,255:PRINT "R1=";REG 127
autostart .EVERY 3 job
autostart POKE 23692,255:PRINT "R2=";REG 127
autostart .EVERY 3 job
autostart POKE 23692,255:PRINT "R3=";REG 127
autostart POKE 23692,255:PRINT "AFTER"
autostart FOR i=0 TO 1 STEP 0:NEXT i
seconds 16
screen 15 AFTER
screen 15 R1=0
screen 15 R2=0
screen 15 R3=1
check /SYS/EVERY.CFG @DATA@/every.cfg
