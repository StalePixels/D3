NAME = D3
# Development builds go to DEV-D3 (not in git). "make release" builds into
# BUILD-D3 and copies to RELEASE-D3. Every file a build writes goes under its
# BUILD_DIR: the programs in BUILD_DIR, everything else in TMP_DIR.
BUILD_DIR ?= DEV-$(NAME)
REL_BUILD_DIR = BUILD-$(NAME)
TMP_DIR = $(BUILD_DIR)/tmp
SRC_DIRS ?= ./src
DOCS_DIR ?= ./docs
FILES_DIR ?= ./dist
RELEASE_DIR ?= ./RELEASE-$(NAME)
INSTALL_BASE ?= /Volumes/devnext
INSTALL_DIR ?= $(INSTALL_BASE)/$(NAME)

Z88DK_CRT = 30

#DEBUGFLAGS := --list --c-code-in-asm

# z88dk runs in its Docker image, with this directory mounted at the same path.
# zcc runs in TMP_DIR, so its output and side files go there. appmake cuts a
# dot command's output name to 8 characters, path included: -o takes a bare
# name, never a path.
Z88DK_IMAGE ?= z88dk/z88dk:latest
Z88DK_RUN = docker run --rm --user $(shell id -u):$(shell id -g) -e HOME=/tmp -v $(CURDIR):$(CURDIR) -w $(CURDIR) $(Z88DK_IMAGE)
Z88DK_RUN_TMP = docker run --rm --user $(shell id -u):$(shell id -g) -e HOME=/tmp -v $(CURDIR):$(CURDIR) -w $(CURDIR)/$(TMP_DIR) $(Z88DK_IMAGE)

# Full optimisation takes minutes for each command: only "make release"
# uses it. Every other build uses zsdcc's default, for fast test builds.
ZOPT ?=
RELEASE_ZOPT = --max-allocs-per-node200000
CC=$(Z88DK_RUN_TMP) zcc
CCFLAGS=+zxn -vn -startup=$(Z88DK_CRT) -clib=sdcc_iy -SO3 $(ZOPT) --opt-code-size --disable-warning=323 -pragma-include:$(CURDIR)/zpragma.inc
CZFLAGS=-Cz="--clean --fullsize --main-fence 0xC000"
LDFLAGS=-m -lm
# build.h is generated into TMP_DIR by the incs target
INCFLAGS=-I$(CURDIR)/$(TMP_DIR)

SH := /bin/sh
ECHO := @/bin/echo -n
CD := cd
RSYNC := rsync -parv
MKDIR := mkdir -p
RM := rm -rfv
LSH := ls -larth
CP := @cp -rv
MV := @mv -v
#FIGLET := echo
FIGLET := `which figlet`
CAT := @`which cat`
SED := @`which sed`
LS := ls -l@k
VERSION := `cat VERSION`
DATE := `which date`

default: q_less

all: ini every untar ch8show inkey less xcopy gunzip

# clean removes the development build. rel-clean also removes the release
# build and the release copies, which are in git.
clean:
	$(RM) $(BUILD_DIR)
	$(RM) cmake-build-debug

rel-clean: clean
	$(RM) $(REL_BUILD_DIR)
	$(RM) $(RELEASE_DIR)

deps: incs

dirs:
	$(MKDIR) $(BUILD_DIR)
	$(MKDIR) $(TMP_DIR)

incs: dirs
	$(ECHO) `git shortlog -s -n HEAD | grep Rimron| cut -b-7|sed -e 's/^[[:space:]]*//'` > $(TMP_DIR)/BUILD
	$(ECHO) "#" > $(TMP_DIR)/BANNER
	$(CAT) $(TMP_DIR)/BUILD >> $(TMP_DIR)/BANNER
	$(ECHO) " RUNNING" >> $(TMP_DIR)/BANNER
	$(CAT)  $(TMP_DIR)/BANNER | $(FIGLET)

	cat templates/build_top.h > $(TMP_DIR)/build.h

	$(ECHO) "// Autogenerated on " >>  $(TMP_DIR)/build.h
	$(DATE) >>  $(TMP_DIR)/build.h

	cat templates/build_build.h >> $(TMP_DIR)/build.h
	$(CAT) $(TMP_DIR)/BUILD >> $(TMP_DIR)/build.h
	echo "\"" >> $(TMP_DIR)/build.h

	cat templates/build_ver.h >> $(TMP_DIR)/build.h
	@tr -d '\r\n' < VERSION >> $(TMP_DIR)/build.h
	echo "\"" >> $(TMP_DIR)/build.h

	cat templates/build_bottom.h >> $(TMP_DIR)/build.h

	@tr -d '\r\n' < VERSION > $(TMP_DIR)/BANNER
	$(ECHO) " done!" >> $(TMP_DIR)/BANNER
	$(CAT) $(TMP_DIR)/BANNER | figlet

release: ZOPT = $(RELEASE_ZOPT)
release: BUILD_DIR = $(REL_BUILD_DIR)
release: ini every untar ch8show inkey less xcopy gunzip
	$(MKDIR) $(RELEASE_DIR)
	$(CP) $(BUILD_DIR)/INI.DOT $(RELEASE_DIR)/INI
	$(CP) $(BUILD_DIR)/EVERY.DOT $(RELEASE_DIR)/EVERY
	$(CP) $(BUILD_DIR)/UNTAR.DOT $(RELEASE_DIR)/UNTAR
	$(CP) $(BUILD_DIR)/CH8SHOW.DOT $(RELEASE_DIR)/CH8SHOW
	$(CP) $(BUILD_DIR)/INKEY.DOT $(RELEASE_DIR)/INKEY
	$(CP) $(BUILD_DIR)/LESS.DOT $(RELEASE_DIR)/LESS
	$(CP) $(BUILD_DIR)/XCOPY.DOT $(RELEASE_DIR)/XCOPY
	$(CP) $(BUILD_DIR)/GUNZIP.DOT $(RELEASE_DIR)/GUNZIP

install: install_every install_ini install_untar install_ch8show install_inkey install_less install_xcopy install_gunzip

uninstall: uninstall_every uninstall_ini uninstall_untar uninstall_ch8show uninstall_inkey uninstall_less uninstall_xcopy uninstall_gunzip


#
# INI
#
ini: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/ini.lst -oINI -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/INI $(BUILD_DIR)/INI.DOT

install_ini:
	$(CP) $(BUILD_DIR)/INI.DOT $(INSTALL_BASE)/dot/INI

q_ini: ini install_ini

uninstall_ini:
	$(RM) $(INSTALL_BASE)/dot/INI


#
# XCOPY
#
# d3_logo goes in the bank with the help text (src/xcopy/bank.asm)
xcopy_d3: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) -c --codesegPAGE_12 --constsegPAGE_12 \
		$(CURDIR)/src/common/d3.c -oXCOPY_D3.o

# The stack starts at $BFE0 (REGISTER_SP in src/xcopy.c). The fence keeps
# 2K below it for the stack.
XCOPY_CZFLAGS = -Cz="--clean --fullsize --main-fence 0xB7E0"

xcopy: deps dirs xcopy_d3
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/xcopy.lst XCOPY_D3.o \
		-oXCOPY -create-app -subtype=dotn $(XCOPY_CZFLAGS)
	$(MV) $(TMP_DIR)/XCOPY $(BUILD_DIR)/XCOPY.DOT

install_xcopy:
	$(CP) $(BUILD_DIR)/XCOPY.DOT $(INSTALL_BASE)/dot/XCOPY

q_xcopy: xcopy install_xcopy

uninstall_xcopy:
	$(RM) $(INSTALL_BASE)/dot/XCOPY


#
# GUNZIP
#
GUNZIP_DIR = src/gunzip

# The decoder's two code images, assembled on their own into TMP_DIR. This
# runs on every build, like the other targets: a file target here would be
# fixed to the development TMP_DIR when make reads the Makefile.
gunzip_inflate: dirs
	$(Z88DK_RUN) z88dk-z80asm -mz80n -b -O$(TMP_DIR)/inflate $(GUNZIP_DIR)/inflate.asm

gunzip: deps dirs gunzip_inflate
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) -Ddotn -Ca-I$(CURDIR)/$(TMP_DIR)/inflate/$(GUNZIP_DIR) -Ca-I$(CURDIR)/$(GUNZIP_DIR) \
		@$(CURDIR)/src/gunzip.lst -oGUNZIP -create-app -subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/GUNZIP $(BUILD_DIR)/GUNZIP.DOT

install_gunzip:
	$(CP) $(BUILD_DIR)/GUNZIP.DOT $(INSTALL_BASE)/dot/GUNZIP

q_gunzip: gunzip install_gunzip

uninstall_gunzip:
	$(RM) $(INSTALL_BASE)/dot/GUNZIP


#
# EVERY
#
every: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/every.lst -oEVERY -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/EVERY $(BUILD_DIR)/EVERY.DOT

install_every:
	$(CP) $(BUILD_DIR)/EVERY.DOT $(INSTALL_BASE)/dot/EVERY

q_every: every install_every

uninstall_every:
	$(RM) $(INSTALL_BASE)/dot/EVERY


#
# UNTAR
#
untar: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/untar.lst -oUNTAR -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/UNTAR $(BUILD_DIR)/UNTAR.DOT

install_untar:
	$(CP) $(BUILD_DIR)/UNTAR.DOT $(INSTALL_BASE)/dot/UNTAR

q_untar: untar install_untar

uninstall_untar:
	$(RM) $(INSTALL_BASE)/dot/UNTAR


#
# CH8SHOW
#
ch8show: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/ch8show.lst -oCH8SHOW -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/CH8SHOW $(BUILD_DIR)/CH8SHOW.DOT

install_ch8show:
	$(CP) $(BUILD_DIR)/CH8SHOW.DOT $(INSTALL_BASE)/dot/CH8SHOW

q_ch8show: ch8show install_ch8show

uninstall_ch8show:
	$(RM) $(INSTALL_BASE)/dot/CH8SHOW


#
# INKEY
#
inkey: deps dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/inkey.lst -oINKEY -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/INKEY $(BUILD_DIR)/INKEY.DOT

install_inkey:
	$(CP) $(BUILD_DIR)/INKEY.DOT $(INSTALL_BASE)/dot/INKEY

q_inkey: inkey install_inkey

uninstall_inkey:
	$(RM) $(INSTALL_BASE)/dot/INKEY


#
# LESS
#

less_l3: dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(BUILDFLAGS) -c \
		--codesegBANK_41 --constsegBANK_41 \
		--datasegBANK_41 --bsssegBANK_41 \
		@$(CURDIR)/src/common/LAYER3.lst -oLESS_LAYER3.o

less_banks: dirs less_l3

less_assemble: deps dirs less_banks less_l3
	$(CC) $(CCFLAGS) $(INCFLAGS) $(LDFLAGS) @$(CURDIR)/src/less.lst LESS_LAYER3.o \
		-oLESS -create-app -subtype=dotn $(CZFLAGS)
	$(MV) $(TMP_DIR)/LESS $(BUILD_DIR)/LESS.DOT

less: deps dirs less_banks less_assemble

install_less:
	$(CP) $(BUILD_DIR)/LESS.DOT $(INSTALL_BASE)/dot/LESS

q_less: dirs less_banks less_assemble install_less

uninstall_less:
	$(RM) $(INSTALL_BASE)/dot/LESS