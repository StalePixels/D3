NAME = D3
BUILD_DIR ?= ./BUILD-$(NAME)
TMP_DIR ?= ./TMP-$(NAME)
SRC_DIRS ?= ./src
DOCS_DIR ?= ./docs
FILES_DIR ?= ./dist
RELEASE_DIR ?= ./RELEASE-$(NAME)
INSTALL_BASE ?= /Volumes/devnext
INSTALL_DIR ?= $(INSTALL_BASE)/$(NAME)

Z88DK_CRT = 30

#DEBUGFLAGS := --list --c-code-in-asm

# z88dk runs in its Docker image, with this directory mounted at the same path
Z88DK_IMAGE ?= z88dk/z88dk:latest
Z88DK_RUN = docker run --rm --user $(shell id -u):$(shell id -g) -e HOME=/tmp -v $(CURDIR):$(CURDIR) -w $(CURDIR) $(Z88DK_IMAGE)

ZOPT ?= --max-allocs-per-node200000
CC=$(Z88DK_RUN) zcc
CCFLAGS=+zxn -vn -startup=$(Z88DK_CRT) -clib=sdcc_iy -SO3 $(ZOPT) --opt-code-size --disable-warning=323 -pragma-include:zpragma.inc
CZFLAGS=-Cz="--clean --fullsize --main-fence 0xC000"
LDFLAGS=-m -lm
INCFLAGS=

SH := /bin/sh
ECHO := @/bin/echo -n
CD := cd
RSYNC := rsync -parv
MKDIR := mkdir -p
RM := rm -rfv
LSH := ls -larth
CP := @cp -rv
MV := @mv -v
#FIGLET := echo
FIGLET := `which figlet`
CAT := @`which cat`
SED := @`which sed`
LS := ls -l@k
VERSION := `cat VERSION`
DATE := `which date`

default: q_less

all: ini every untar ch8show inkey less xcopy gunzip

clean:
	$(RM) $(BUILD_DIR)
	$(RM) $(TMP_DIR)
	$(RM) $(NAME).map
	$(RM) $(NAME)_*.bin
	$(RM) cmake-build-debug
	$(RM) *.map
	$(RM) *_MAIN.bin
	$(RM) *_CODE.bin
	$(RM) *_UNASSIGNED.bin
	$(RM) *_UNASSIGNED.bin
	$(RM) $(GUNZIP_DIR)/inflate_PAGEA.bin $(GUNZIP_DIR)/inflate_PAGEC.bin

rel-clean: clean
	$(RM) $(RELEASE_DIR)

deps: incs
	$(ECHO) $(NAME) > NAME

dirs:
	$(MKDIR) $(BUILD_DIR)
	$(MKDIR) $(TMP_DIR)
	$(MKDIR) $(RELEASE_DIR)

incs: dirs
	$(ECHO) `git shortlog -s -n| grep Rimron| cut -b-7|sed -e 's/^[[:space:]]*//'` > $(TMP_DIR)/BUILD
	$(ECHO) "#" > $(TMP_DIR)/BANNER
	$(CAT) $(TMP_DIR)/BUILD >> $(TMP_DIR)/BANNER
	$(ECHO) " RUNNING" >> $(TMP_DIR)/BANNER
	$(CAT)  $(TMP_DIR)/BANNER | $(FIGLET)

	cat templates/build_top.h > src/common/build.h

	$(ECHO) "// Autogenerated on " >>  src/common/build.h
	$(DATE) >>  src/common/build.h

	cat templates/build_build.h >> src/common/build.h
	$(CAT) $(TMP_DIR)/BUILD >> src/common/build.h
	echo "\"" >> src/common/build.h

	cat templates/build_ver.h >> src/common/build.h
	@tr -d '\r\n' < VERSION >> src/common/build.h
	echo "\"" >> src/common/build.h

	cat templates/build_bottom.h >> src/common/build.h

	@tr -d '\r\n' < VERSION > $(TMP_DIR)/BANNER
	$(ECHO) " done!" >> $(TMP_DIR)/BANNER
	$(CAT) $(TMP_DIR)/BANNER | figlet

release: ini every untar ch8show inkey less xcopy gunzip
	$(CP) $(BUILD_DIR)/INI.DOT $(RELEASE_DIR)/INI
	$(CP) $(BUILD_DIR)/EVERY.DOT $(RELEASE_DIR)/EVERY
	$(CP) $(BUILD_DIR)/UNTAR.DOT $(RELEASE_DIR)/UNTAR
	$(CP) $(BUILD_DIR)/CH8SHOW.DOT $(RELEASE_DIR)/CH8SHOW
	$(CP) $(BUILD_DIR)/INKEY.DOT $(RELEASE_DIR)/INKEY
	$(CP) $(BUILD_DIR)/LESS.DOT $(RELEASE_DIR)/LESS
	$(CP) $(BUILD_DIR)/XCOPY.DOT $(RELEASE_DIR)/XCOPY
	$(CP) $(BUILD_DIR)/GUNZIP.DOT $(RELEASE_DIR)/GUNZIP

install: install_every install_ini install_untar install_ch8show install_inkey install_less install_xcopy install_gunzip

uninstall: uninstall_every uninstall_ini uninstall_untar uninstall_ch8show uninstall_inkey uninstall_less uninstall_xcopy uninstall_gunzip


#
# INI
#
ini: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/ini.lst -oINI -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) INI $(BUILD_DIR)/INI.DOT

install_ini:
	$(CP) $(BUILD_DIR)/INI.DOT $(INSTALL_BASE)/dot/INI

q_ini: ini install_ini

uninstall_ini:
	$(RM) $(INSTALL_BASE)/dot/INI


#
# XCOPY
#
xcopy: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/xcopy.lst -oXCOPY -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) XCOPY $(BUILD_DIR)/XCOPY.DOT

install_xcopy:
	$(CP) $(BUILD_DIR)/XCOPY.DOT $(INSTALL_BASE)/dot/XCOPY

q_xcopy: xcopy install_xcopy

uninstall_xcopy:
	$(RM) $(INSTALL_BASE)/dot/XCOPY


#
# GUNZIP
#
GUNZIP_DIR = src/gunzip

# The decoder's two code images, assembled on their own inside src/gunzip
$(GUNZIP_DIR)/inflate_PAGEA.bin $(GUNZIP_DIR)/inflate_PAGEC.bin: $(GUNZIP_DIR)/inflate.asm $(GUNZIP_DIR)/inflate_job.inc
	$(Z88DK_RUN) sh -c "cd $(GUNZIP_DIR) && z88dk-z80asm -mz80n -b inflate.asm"
	rm -f $(GUNZIP_DIR)/inflate.o $(GUNZIP_DIR)/inflate.bin

gunzip: deps dirs $(GUNZIP_DIR)/inflate_PAGEA.bin $(GUNZIP_DIR)/inflate_PAGEC.bin
	$(CC) $(CCFLAGS) $(LDFLAGS) -Ddotn -Ca-I$(CURDIR)/$(GUNZIP_DIR) @src/gunzip.lst -oGUNZIP -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) GUNZIP $(BUILD_DIR)/GUNZIP.DOT

install_gunzip:
	$(CP) $(BUILD_DIR)/GUNZIP.DOT $(INSTALL_BASE)/dot/GUNZIP

q_gunzip: gunzip install_gunzip

uninstall_gunzip:
	$(RM) $(INSTALL_BASE)/dot/GUNZIP


#
# EVERY
#
every: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/every.lst -oEVERY -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) EVERY $(BUILD_DIR)/EVERY.DOT

install_every:
	$(CP) $(BUILD_DIR)/EVERY.DOT $(INSTALL_BASE)/dot/EVERY

q_every: every install_every

uninstall_every:
	$(RM) $(INSTALL_BASE)/dot/EVERY


#
# UNTAR
#
untar: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/untar.lst -oUNTAR -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) UNTAR $(BUILD_DIR)/UNTAR.DOT

install_untar:
	$(CP) $(BUILD_DIR)/UNTAR.DOT $(INSTALL_BASE)/dot/UNTAR

q_untar: untar install_untar

uninstall_untar:
	$(RM) $(INSTALL_BASE)/dot/UNTAR


#
# CH8SHOW
#
ch8show: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/ch8show.lst -oCH8SHOW -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) CH8SHOW $(BUILD_DIR)/CH8SHOW.DOT

install_ch8show:
	$(CP) $(BUILD_DIR)/CH8SHOW.DOT $(INSTALL_BASE)/dot/CH8SHOW

q_ch8show: ch8show install_ch8show

uninstall_ch8show:
	$(RM) $(INSTALL_BASE)/dot/CH8SHOW


#
# INKEY
#
inkey: deps dirs
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/inkey.lst -oINKEY -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) INKEY $(BUILD_DIR)/INKEY.DOT

install_inkey:
	$(CP) $(BUILD_DIR)/INKEY.DOT $(INSTALL_BASE)/dot/INKEY

q_inkey: inkey install_inkey

uninstall_inkey:
	$(RM) $(INSTALL_BASE)/dot/INKEY


#
# LESS
#

less_l3: dirs
	$(CC) $(CCFLAGS) $(INCFLAGS) $(BUILDFLAGS) -c \
		--codesegBANK_41 --constsegBANK_41 \
		--datasegBANK_41 --bsssegBANK_41 \
		@src/common/LAYER3.lst -o./LESS_LAYER3.o

less_banks: dirs less_l3

less_assemble: dirs less_banks less_l3
	$(CC) $(CCFLAGS) $(LDFLAGS) @src/less.lst -oLESS -create-app \
		-subtype=dotn $(CZFLAGS)
	$(MV) LESS $(BUILD_DIR)/LESS.DOT

less: deps dirs less_banks less_assemble

install_less:
	$(CP) $(BUILD_DIR)/LESS.DOT $(INSTALL_BASE)/dot/LESS

q_less: dirs less_banks less_assemble install_less

uninstall_less:
	$(RM) $(INSTALL_BASE)/dot/LESS